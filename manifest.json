{
  "manifest_version": 3,
  "name": "AI Post Detector for X",
  "version": "1.0.0",
  "description": "Highlights posts on X that are likely AI-generated based on typographic markers like em dashes and curly quotes",
  "permissions": [],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
